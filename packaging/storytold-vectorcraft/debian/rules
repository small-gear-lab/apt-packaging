#!/usr/bin/make -f
# vectorcraft: the GUI and vectorcraft-cli. Built offline with the builder's own Rust toolchain, from the crates that
# build.sh vendored into vendor/ (.cargo/config.toml points cargo at them).

# No LTO: some crates have C code (the cc crate) that rustc links, and LTO objects of the C compiler do not mix with that.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk
export CFLAGS CPPFLAGS

export CARGO_NET_OFFLINE = true
export CARGO_HOME ?= $(CURDIR)/debian/cargo-home
APP_ID = ai.storyteller.vectorcraft
LINUX = packaging/linux
GUI = $(CURDIR)/debian/storytold-vectorcraft
CLI = $(CURDIR)/debian/storytold-vectorcraft-cli
# The release date written into the AppStream metadata: the date of the changelog entry, in UTC.
DATE = $(shell date -u -d "$$(dpkg-parsechangelog -S Date)" +%Y-%m-%d)
UPSTREAM_VERSION = $(shell dpkg-parsechangelog -S Version | sed -E 's/-[^-]*$$//')

%:
	dh $@

override_dh_auto_configure:

# HEIC/HEIF support is a default feature of vectorcraft-engine (both apps ask for it), so there is no --features here.
# vectorcraft-cli has no example that writes man pages or completions: its man page is debian/vectorcraft-cli.1.
override_dh_auto_build:
	cargo build --release --locked --offline -p vectorcraft -p vectorcraft-cli --bins

override_dh_auto_install:
	install -Dm755 target/release/vectorcraft $(GUI)/usr/bin/vectorcraft
	install -Dm644 $(LINUX)/$(APP_ID).desktop $(GUI)/usr/share/applications/$(APP_ID).desktop
	install -Dm644 $(LINUX)/$(APP_ID).mime.xml $(GUI)/usr/share/mime/packages/$(APP_ID).xml
	install -d $(GUI)/usr/share/metainfo
	sed -e 's/@VERSION@/$(UPSTREAM_VERSION)/g' -e 's/@DATE@/$(DATE)/g' \
		$(LINUX)/$(APP_ID).metainfo.xml.in > $(GUI)/usr/share/metainfo/$(APP_ID).metainfo.xml
	install -d $(GUI)/usr/share/icons
	cp -R assets/app-icon/hicolor $(GUI)/usr/share/icons/
	install -Dm644 NOTICE $(GUI)/usr/share/doc/storytold-vectorcraft/NOTICE
	install -Dm755 target/release/vectorcraft-cli $(CLI)/usr/bin/vectorcraft-cli
	install -Dm644 NOTICE $(CLI)/usr/share/doc/storytold-vectorcraft-cli/NOTICE

override_dh_auto_test:
	# upstream's tests are not run in this local build

# The release profile has no debug information, so a -dbgsym package would only hold empty debug files.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_clean:
	rm -rf target debian/cargo-home
