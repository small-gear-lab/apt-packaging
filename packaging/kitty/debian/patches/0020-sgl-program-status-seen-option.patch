 SGL_PROGRAM_STATUS_STATES = ('idle', 'working', 'blocked', 'done', 'error')
 
 
+SGL_PROGRAM_STATUS_SEEN_ACTIONS = ('idle', 'keep', 'remove')
+
+
+def sgl__program_status_seen(val: str) -> Iterable[tuple[str, str]]:
+    # Local option (small-gear-lab package): app (or *), action
+    parts = val.split()
+    if len(parts) != 2:
+        raise ValueError('must have an app name (or *) and an action')
+    app, action = parts
+    if action not in SGL_PROGRAM_STATUS_SEEN_ACTIONS:
+        raise ValueError(f'unknown action {action!r}, must be one of {", ".join(SGL_PROGRAM_STATUS_SEEN_ACTIONS)}')
+    if app != '*' and not re.fullmatch(r'[A-Za-z0-9_.+-]+', app):
+        raise ValueError(f'{app!r} is not a valid app name')
+    yield app, action
+
+
