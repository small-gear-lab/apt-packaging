--- kitty-0.50.0.orig/kitty_tests/program_status.py
+++ kitty-0.50.0/kitty_tests/program_status.py
@@ -209,6 +209,36 @@ class TestProgramStatus(BaseTest):
         self.ae(combined_status_symbol([w]), '\uf110  30% ')
         self.ae([d['id'] for d in w.as_list()], ['y', 'x'])
 
+    def test_sgl_program_status_seen(self):
+        from kitty.options.utils import sgl__program_status_seen as parse
+        self.ae(dict(parse('logstream remove')), {'logstream': 'remove'})
+        self.ae(dict(parse('* keep')), {'*': 'keep'})
+        for bad in ('logstream', 'logstream bogus', 'bad/app remove', 'a b c'):
+            with self.assertRaises(ValueError, msg=bad):
+                tuple(parse(bad))
+        import kitty.program_status as m
+        ps = ProgramStatus()
+
+        def run(actions, report, expect_state, expect_changed=True):
+            old = m.seen_actions
+            m.seen_actions = lambda: actions
+            try:
+                ps.clear()
+                ps.apply(parse_report(report))
+                self.ae(ps.on_seen_by_user(), expect_changed)
+            finally:
+                m.seen_actions = old
+            self.ae(ps.records[''].state if '' in ps.records else None, expect_state)
+        # default: idle
+        run({}, 'state=error:app=logstream', State.idle)
+        # per app
+        run({'logstream': 'remove'}, 'state=error:app=logstream', None)
+        run({'logstream': 'remove'}, 'state=done:app=claude-code', State.idle)
+        run({'logstream': 'keep'}, 'state=error:app=logstream', State.error, expect_changed=False)
+        # * applies to apps without an entry; an entry of the app wins
+        run({'*': 'remove'}, 'state=done:app=x', None)
+        run({'*': 'remove', 'claude-code': 'idle'}, 'state=done:app=claude-code', State.idle)
+
     def test_sgl_program_status_symbol(self):
         from kitty.options.utils import sgl__program_status_symbol as parse
