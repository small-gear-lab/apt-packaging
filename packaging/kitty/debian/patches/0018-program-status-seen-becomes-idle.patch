--- kitty-0.50.0.orig/kitty/program_status.py
+++ kitty-0.50.0/kitty/program_status.py
@@ -248,7 +248,17 @@ class ProgramStatus:
         return self.remove(lambda r: r.state in TRANSIENT_STATES)
 
     def on_seen_by_user(self) -> bool:
-        return self.remove(lambda r: r.state in UNSEEN_STATES)
+        # Local change: once the user has seen a finished or failed root record it becomes idle instead of
+        # vanishing, so that the window keeps showing that its program is waiting. Other records are removed.
+        changed = False
+        for rid, r in tuple(self.records.items()):
+            if r.state in UNSEEN_STATES:
+                if rid:
+                    self.discard(rid)
+                else:
+                    self.records[rid] = Record(id=rid, state=State.idle, app=r.app)
+                changed = True
+        return changed
 
     def app_for(self, record: Record) -> str:
         "The app of a record, inherited from its nearest ancestor if absent"
