--- kitty-0.50.0.orig/kitty/options/utils.py
+++ kitty-0.50.0/kitty/options/utils.py
@@ -1290,6 +1290,33 @@ def symbol_map(val: str) -> Iterable[tup
     yield from symbol_map_parser(val)
 
 
+SGL_PROGRAM_STATUS_STATES = ('idle', 'working', 'blocked', 'done', 'error')
+
+
+def sgl__program_status_symbol(val: str) -> Iterable[tuple[str, tuple[int, str, str]]]:
+    # Local option (small-gear-lab package): state, codepoint, color [, font family]
+    parts = val.split()
+    if len(parts) < 3:
+        raise ValueError('must have state, codepoint and color')
+    state, cp, color = parts[:3]
+    family = ' '.join(parts[3:])
+    if state not in SGL_PROGRAM_STATUS_STATES:
+        raise ValueError(f'unknown state {state!r}, must be one of {", ".join(SGL_PROGRAM_STATUS_STATES)}')
+    if not cp.startswith('U+'):
+        raise ValueError(f'{cp} is not a unicode codepoint of the form U+number')
+    cpi = int(cp[2:], 16)
+    if not 0 < cpi <= sys.maxunicode:
+        raise ValueError(f'Invalid codepoint: {cpi:x}')
+    if color.lower() != 'none':
+        c = to_color(color)
+        if c is None:
+            raise ValueError(f'{color} is not a valid color')
+        color = f'#{c.red:02x}{c.green:02x}{c.blue:02x}'
+    else:
+        color = 'none'
+    yield state, (cpi, color, family)
+
+
 def narrow_symbols(val: str) -> Iterable[tuple[tuple[int, int], int]]:
     for x, y in symbol_map_parser(val, min_size=1):
         yield x, int(y or 1)
