+        self.ae(dict(parse('working U+F0184 #4A90E2 Symbols Nerd Font Mono')), {'working': (0xF0184, '#4a90e2', 'Symbols Nerd Font Mono')})
+        self.ae(dict(parse('idle U+25CB none')), {'idle': (0x25CB, 'none', '')})
+        for bad in ('working', 'working U+F0184', 'bogus U+F0184 none', 'working F0184 none', 'working U+F0184 notacolor'):
