+#include "SocksProxyCommand.h"
+
+#include "Request.h"
+#include "DownloadEngine.h"
+#include "RequestGroup.h"
+#include "Option.h"
+#include "prefs.h"
+#include "SocketCore.h"
+#include "Socks5Handshake.h"
+#include "fmt.h"
+#include "LogFactory.h"
+#include "Logger.h"
+
+namespace aria2 {
+
+SocksProxyCommand::SocksProxyCommand(
+    cuid_t cuid, const std::shared_ptr<Request>& req,
+    const std::shared_ptr<FileEntry>& fileEntry, RequestGroup* requestGroup,
+    DownloadEngine* e, const std::shared_ptr<Request>& proxyRequest,
+    const std::shared_ptr<SocketCore>& s, NextCommandFactory nextCommandFactory)
+    : AbstractCommand(cuid, req, fileEntry, requestGroup, e, s),
+      proxyRequest_(proxyRequest),
+      nextCommandFactory_(std::move(nextCommandFactory)),
+      state_(proxyRequest->getProtocol() == "socks5" ? SOCKS_RESOLVE
+                                                     : SOCKS_HANDSHAKE)
+{
+  setTimeout(std::chrono::seconds(getOption()->getAsInt(PREF_CONNECT_TIMEOUT)));
+  disableReadCheckSocket();
+  if (state_ == SOCKS_RESOLVE) {
+    // Resolve the target host locally before talking to the proxy.
+    disableWriteCheckSocket();
+  }
+  else {
+    setWriteCheckSocket(getSocket());
+  }
+}
+
+SocksProxyCommand::~SocksProxyCommand() = default;
+
+bool SocksProxyCommand::isSocksProtocol(const std::string& protocol)
+{
+  return protocol == "socks5" || protocol == "socks5h";
+}
+
+bool SocksProxyCommand::executeInternal()
+{
+  if (state_ == SOCKS_RESOLVE) {
+    std::vector<std::string> addrs;
+    targetAddr_ = resolveHostname(addrs, getRequest()->getHost(),
+                                  getRequest()->getPort());
+    if (targetAddr_.empty()) {
+      addCommandSelf();
+      return false;
+    }
+    state_ = SOCKS_HANDSHAKE;
+  }
+
+  if (!handshake_) {
+    handshake_ = make_unique<Socks5Handshake>(
+        proxyRequest_->getUsername(), proxyRequest_->getPassword(),
+        getRequest()->getHost(), targetAddr_, getRequest()->getPort());
+    A2_LOG_INFO(fmt(
+        "CUID#%" PRId64 " - SOCKS5 CONNECT to %s:%d via proxy %s:%d", getCuid(),
+        targetAddr_.empty() ? getRequest()->getHost().c_str()
+                            : targetAddr_.c_str(),
+        getRequest()->getPort(), proxyRequest_->getHost().c_str(),
+        proxyRequest_->getPort()));
+  }
+
+  switch (handshake_->advance(*getSocket())) {
+  case Socks5Handshake::WANT_READ:
+    disableWriteCheckSocket();
+    setReadCheckSocket(getSocket());
+    addCommandSelf();
+    return false;
+
+  case Socks5Handshake::WANT_WRITE:
+    disableReadCheckSocket();
+    setWriteCheckSocket(getSocket());
+    addCommandSelf();
+    return false;
+
+  case Socks5Handshake::DONE:
+    break;
+  }
+
+  A2_LOG_INFO(fmt("CUID#%" PRId64 " - SOCKS5 tunnel established to %s:%d",
+                  getCuid(), getRequest()->getHost().c_str(),
+                  getRequest()->getPort()));
+  getDownloadEngine()->addCommand(nextCommandFactory_(this));
+  return true;
+}
+
+} // namespace aria2
