 /// Larger images are scaled down to this size when they are decoded, to stay within the texture limits.
 const MAX_SIDE: u32 = 8192;
+/// The decoded frames of an animation may take this many bytes at most.
+const MAX_ANIMATION_BYTES: usize = 512 * 1024 * 1024;
+/// The longer side of a rasterized SVG, in pixels.
+const SVG_SIDE: f32 = 4096.0;
 
