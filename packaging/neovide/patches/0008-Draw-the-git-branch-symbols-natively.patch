From 310b2513f31548eabc3fa13a5c1499520c82a1d3 Mon Sep 17 00:00:00 2001
From: small-gear-lab <289302950+marie-222@users.noreply.github.com>
Date: Tue, 10 Nov 2026 16:21:05 +0900
Subject: [PATCH] Draw the git branch symbols (U+F5D0..U+F5FB) natively

The private use area symbols for git-like graphs (lines, curves, joints and
commit circles; designed for vim-flog and also drawn by kitty) are drawn with
the box drawing renderer instead of relying on a font. The shapes follow the
layout of the symbols, not any other implementation. The commit circles
follow the height of the line and may spill over into the neighbouring
cells.
---
 src/renderer/box_drawing/renderer.rs | 189 ++++++++++++++++++++++++++-
 1 file changed, 188 insertions(+), 1 deletion(-)

diff --git a/src/renderer/box_drawing/renderer.rs b/src/renderer/box_drawing/renderer.rs
index a89d9d1..cd49ea5 100644
--- a/src/renderer/box_drawing/renderer.rs
+++ b/src/renderer/box_drawing/renderer.rs
@@ -782,6 +782,52 @@ impl<'a> Context<'a> {
     }
 }
 
+impl<'a> Context<'a> {
+    /// A commit of a git graph: a filled or a hollow circle, with lines running from it to the
+    /// sides of the cell. The lines start at the edge of the circle, so a hollow circle stays empty.
+    fn draw_branch_commit(&self, filled: bool, left: bool, right: bool, up: bool, down: bool) {
+        let stroke_width = self.get_stroke_width_pixels(Thickness::Thin);
+        let min = self.bounding_box.min;
+        let max = self.bounding_box.max;
+        let center = self.bounding_box.center();
+        // The lines of the other branch symbols are aligned like this, so they meet the circle's center
+        let cx = center.x.align_mid_line(stroke_width);
+        let cy = center.y.align_mid_line(stroke_width);
+        let width = max.x - min.x;
+        let height = max.y - min.y;
+        // The size follows the height of the line. A circle wider than the cell spills over into the
+        // neighbouring cells (the clip rectangle of these symbols is widened, see draw_box_glyph)
+        let radius = (height * 0.28).min(width * 0.9).max(stroke_width * 1.5);
+
+        let mut line = self.fg_paint();
+        line.set_style(PaintStyle::Stroke);
+        line.set_stroke_width(stroke_width);
+        if up {
+            self.canvas.draw_line(Point::new(cx, min.y.round()), Point::new(cx, cy - radius), &line);
+        }
+        if down {
+            self.canvas.draw_line(Point::new(cx, cy + radius), Point::new(cx, max.y.round()), &line);
+        }
+        if left && cx - radius > min.x.round() {
+            self.canvas.draw_line(Point::new(min.x.round(), cy), Point::new(cx - radius, cy), &line);
+        }
+        if right && cx + radius < max.x.round() {
+            self.canvas.draw_line(Point::new(cx + radius, cy), Point::new(max.x.round(), cy), &line);
+        }
+
+        let mut circle = self.fg_paint();
+        circle.set_anti_alias(true);
+        if filled {
+            circle.set_style(PaintStyle::Fill);
+            self.canvas.draw_circle(Point::new(cx, cy), radius, &circle);
+        } else {
+            circle.set_style(PaintStyle::Stroke);
+            circle.set_stroke_width(stroke_width);
+            self.canvas.draw_circle(Point::new(cx, cy), radius - stroke_width * 0.5, &circle);
+        }
+    }
+}
+
 #[derive(Clone, Copy)]
 enum Height {
     Tall,
@@ -1698,6 +1744,138 @@ static BOX_CHARS: LazyLock<BTreeMap<char, BoxDrawFn>> = LazyLock::new(|| {
