+    // Branch drawing symbols for git-like graphs (the private use area U+F5D0..U+F5FB). The set was
+    // designed for vim-flog and is also drawn by kitty. These shapes are drawn from the layout of the
+    // symbols (which sides they connect, which joints are curved), not copied from any implementation.
+    box_char!['\u{F5D0}' -> |ctx: &Context| { ctx.draw_fg_line1(Horizontal, HalfSelector::Both); }];
+    box_char!['\u{F5D1}' -> |ctx: &Context| { ctx.draw_fg_line1(Vertical, HalfSelector::Both); }];
+    box_char!['\u{F5D2}' -> |ctx: &Context| { ctx.draw_dashed_line(Horizontal, Thickness::Thin, 3); }];
+    box_char!['\u{F5D3}' -> |ctx: &Context| { ctx.draw_dashed_line(Horizontal, Thickness::Thin, 4); }];
+    box_char!['\u{F5D4}' -> |ctx: &Context| { ctx.draw_dashed_line(Vertical, Thickness::Thin, 3); }];
+    box_char!['\u{F5D5}' -> |ctx: &Context| { ctx.draw_dashed_line(Vertical, Thickness::Thin, 4); }];
+    // Curves: right-down, left-down, right-up, left-up
+    box_char!['\u{F5D6}' -> |ctx: &Context| { ctx.draw_rounded_corner(Corner::TopLeft); }];
+    box_char!['\u{F5D7}' -> |ctx: &Context| { ctx.draw_rounded_corner(Corner::TopRight); }];
+    box_char!['\u{F5D8}' -> |ctx: &Context| { ctx.draw_rounded_corner(Corner::BottomLeft); }];
+    box_char!['\u{F5D9}' -> |ctx: &Context| { ctx.draw_rounded_corner(Corner::BottomRight); }];
+    // A vertical line with a curved branch to the right (up, down, both) or to the left (up, down, both)
+    box_char!['\u{F5DA}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+    }];
+    box_char!['\u{F5DB}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+    }];
+    box_char!['\u{F5DC}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+    }];
+    box_char!['\u{F5DD}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+    }];
+    box_char!['\u{F5DE}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    box_char!['\u{F5DF}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    // A horizontal line with a stem down: the left arm curved, the right arm curved, both curved
+    box_char!['\u{F5E0}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::Last);
+        ctx.draw_fg_line1(Vertical, HalfSelector::Last);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    box_char!['\u{F5E1}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::First);
+        ctx.draw_fg_line1(Vertical, HalfSelector::Last);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+    }];
+    box_char!['\u{F5E2}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Last);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    // The same with a stem up
+    box_char!['\u{F5E3}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::Last);
+        ctx.draw_fg_line1(Vertical, HalfSelector::First);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+    }];
+    box_char!['\u{F5E4}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::First);
+        ctx.draw_fg_line1(Vertical, HalfSelector::First);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+    }];
+    box_char!['\u{F5E5}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::First);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+    }];
+    // A vertical line that both side branches curve into, upwards or downwards
+    box_char!['\u{F5E6}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+    }];
+    box_char!['\u{F5E7}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Vertical, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    // A horizontal line that the vertical line curves into from both sides of one end
+    box_char!['\u{F5E8}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    box_char!['\u{F5E9}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+    }];
+    // A vertical line that is shifted to the side in the middle (an S shaped joint), without and with a bar
+    box_char!['\u{F5EA}' -> |ctx: &Context| {
+        ctx.draw_rounded_corner(Corner::BottomRight);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+    }];
+    box_char!['\u{F5EB}' -> |ctx: &Context| {
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    box_char!['\u{F5EC}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomRight);
+        ctx.draw_rounded_corner(Corner::TopLeft);
+    }];
+    box_char!['\u{F5ED}' -> |ctx: &Context| {
+        ctx.draw_fg_line1(Horizontal, HalfSelector::Both);
+        ctx.draw_rounded_corner(Corner::BottomLeft);
+        ctx.draw_rounded_corner(Corner::TopRight);
+    }];
+    // Commits: a filled circle (a merge) and a hollow circle, alone and with lines to the right, to the
+    // left, to both sides, downwards, upwards, and up and down
+    box_char!['\u{F5EE}' -> |ctx: &Context| { ctx.draw_branch_commit(true, false, false, false, false); }];
+    box_char!['\u{F5EF}' -> |ctx: &Context| { ctx.draw_branch_commit(false, false, false, false, false); }];
+    box_char!['\u{F5F0}' -> |ctx: &Context| { ctx.draw_branch_commit(true, false, true, false, false); }];
+    box_char!['\u{F5F1}' -> |ctx: &Context| { ctx.draw_branch_commit(false, false, true, false, false); }];
+    box_char!['\u{F5F2}' -> |ctx: &Context| { ctx.draw_branch_commit(true, true, false, false, false); }];
+    box_char!['\u{F5F3}' -> |ctx: &Context| { ctx.draw_branch_commit(false, true, false, false, false); }];
+    box_char!['\u{F5F4}' -> |ctx: &Context| { ctx.draw_branch_commit(true, true, true, false, false); }];
+    box_char!['\u{F5F5}' -> |ctx: &Context| { ctx.draw_branch_commit(false, true, true, false, false); }];
+    box_char!['\u{F5F6}' -> |ctx: &Context| { ctx.draw_branch_commit(true, false, false, false, true); }];
+    box_char!['\u{F5F7}' -> |ctx: &Context| { ctx.draw_branch_commit(false, false, false, false, true); }];
+    box_char!['\u{F5F8}' -> |ctx: &Context| { ctx.draw_branch_commit(true, false, false, true, false); }];
+    box_char!['\u{F5F9}' -> |ctx: &Context| { ctx.draw_branch_commit(false, false, false, true, false); }];
+    box_char!['\u{F5FA}' -> |ctx: &Context| { ctx.draw_branch_commit(true, false, false, true, true); }];
+    box_char!['\u{F5FB}' -> |ctx: &Context| { ctx.draw_branch_commit(false, false, false, true, true); }];
+
     m
 });
 
