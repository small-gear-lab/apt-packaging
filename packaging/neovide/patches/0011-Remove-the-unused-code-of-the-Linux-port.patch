             self.route_launch_config_for_window_creation(args.as_ref(), creating_initial_window);
 
@@ -1475,7 +1475,7 @@ impl WinitWindowWrapper {
             cwd: route_cwd,
             pending_initial_window_size,
             state,
-            #[cfg(unix)]
+            #[cfg(target_os = "macos")]
             launch_config: route_launch_config,
