From 7e5f1f57332c9dceb81fc2727e62269fe36ce8b9 Mon Sep 17 00:00:00 2001
From: small-gear-lab <289302950+marie-222@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:20:27 +0900
Subject: [PATCH] Remove the unused code of the Linux port

The launch config of a route is read only by the macOS code that opens a new
window like the focused one, and require_active_handler only by the macOS
menu: they are macOS only again, and the Linux RouteLaunchConfig is gone.
Also remove two helper methods of ImageOverlays that nothing calls.
---
 src/bridge/mod.rs             |  2 +-
 src/bridge/ui_commands.rs     |  2 +-
 src/renderer/image_overlay.rs |  4 ----
 src/window/wrapper/linux.rs   | 39 -----------------------------------
 src/window/wrapper/mod.rs     |  6 +++---
 5 files changed, 5 insertions(+), 48 deletions(-)

diff --git a/src/bridge/mod.rs b/src/bridge/mod.rs
index aeb3a6e..a6cc57a 100644
--- a/src/bridge/mod.rs
+++ b/src/bridge/mod.rs
@@ -58,7 +58,7 @@ pub use transition::TransitionFailure;
 pub use ui_commands::ParallelCommand;
 pub use ui_commands::SerialCommand;
 pub use ui_commands::get_active_handler;
-#[cfg(unix)]
+#[cfg(target_os = "macos")]
 pub use ui_commands::require_active_handler;
 #[cfg(unix)]
 pub use ui_commands::send_or_queue_file_drop;
diff --git a/src/bridge/ui_commands.rs b/src/bridge/ui_commands.rs
index c087646..b693f5c 100644
--- a/src/bridge/ui_commands.rs
+++ b/src/bridge/ui_commands.rs
@@ -117,7 +117,7 @@ pub fn get_active_handler() -> Option<NeovimHandler> {
     HANDLER_REGISTRY.lock().unwrap().active().cloned()
 }
 
-#[cfg(unix)]
+#[cfg(target_os = "macos")]
 pub fn require_active_handler() -> NeovimHandler {
     get_active_handler().expect("NeovimHandler has not been initialized")
 }
diff --git a/src/renderer/image_overlay.rs b/src/renderer/image_overlay.rs
index f5471d9..e9e87d7 100644
--- a/src/renderer/image_overlay.rs
+++ b/src/renderer/image_overlay.rs
@@ -279,10 +279,6 @@ fn decode(path: &Path) -> Vec<Frame> {
 }
 
 impl ImageOverlays {
-    pub fn is_empty(&self) -> bool { self.specs.is_empty() }
-
-    pub fn has(&self, window: u64) -> bool { self.specs.contains_key(&window) }
-
     pub fn clear(&mut self, window: u64) {
         self.specs.remove(&window);
         self.forget_unused();
