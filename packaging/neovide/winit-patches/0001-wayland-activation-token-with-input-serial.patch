             Arc::downgrade(&self.attention_requested),
         ));
         let xdg_activation_token = xdg_activation.get_activation_token(&self.queue_handle, data);
-        xdg_activation_token.set_surface(&surface);
+        if let Some((seat, serial)) = super::types::xdg_activation::latest_input_serial() {
+            // The serial belongs to the surface that received the input, which is not the one being activated.
+            let source = super::types::xdg_activation::keyboard_focus_surface()
+                .unwrap_or_else(|| surface.clone());
+            xdg_activation_token.set_surface(&source);
+            xdg_activation_token.set_serial(serial, &seat);
+        } else {
+            xdg_activation_token.set_surface(&surface);
+        }
         xdg_activation_token.commit();
     }
 
