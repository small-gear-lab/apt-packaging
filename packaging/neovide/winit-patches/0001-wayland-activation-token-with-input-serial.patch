 //! Handling of xdg activation, which is used for user attention requests.
 
 use std::sync::atomic::AtomicBool;
-use std::sync::Weak;
+use std::sync::{Mutex, Weak};
 
 use sctk::reexports::client::globals::{BindError, GlobalList};
+use sctk::reexports::client::protocol::wl_seat::WlSeat;
 use sctk::reexports::client::protocol::wl_surface::WlSurface;
 use sctk::reexports::client::{delegate_dispatch, Connection, Dispatch, Proxy, QueueHandle};
 use sctk::reexports::protocols::xdg::activation::v1::client::xdg_activation_token_v1::{
@@ -18,6 +19,34 @@
 use crate::platform_impl::WindowId;
 use crate::window::ActivationToken;
 
+/// The seat and serial of the latest key press. An activation token that carries it is accepted by
+/// compositors that refuse to move the focus without a recent user input (GNOME).
+static LATEST_INPUT_SERIAL: Mutex<Option<(WlSeat, u32)>> = Mutex::new(None);
+
+pub fn remember_input_serial(seat: WlSeat, serial: u32) {
+    if let Ok(mut latest) = LATEST_INPUT_SERIAL.lock() {
+        *latest = Some((seat, serial));
+    }
+}
+
+/// The surface that had the keyboard focus. The token has to name it, because the compositor matches the serial
+/// against the surface that received the input.
+static KEYBOARD_FOCUS_SURFACE: Mutex<Option<WlSurface>> = Mutex::new(None);
+
+pub fn remember_keyboard_focus(surface: WlSurface) {
+    if let Ok(mut latest) = KEYBOARD_FOCUS_SURFACE.lock() {
+        *latest = Some(surface);
+    }
+}
+
+pub fn keyboard_focus_surface() -> Option<WlSurface> {
+    KEYBOARD_FOCUS_SURFACE.lock().ok().and_then(|latest| latest.clone())
+}
+
+pub fn latest_input_serial() -> Option<(WlSeat, u32)> {
+    LATEST_INPUT_SERIAL.lock().ok().and_then(|latest| latest.clone())
+}
+
 pub struct XdgActivationState {
     xdg_activation: XdgActivationV1,
 }
diff -ruN a/src/platform_impl/linux/wayland/window/mod.rs winit-0.30.13/src/platform_impl/linux/wayland/window/mod.rs
