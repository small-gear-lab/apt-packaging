+                    ecdh_doit[R_EC_BRP384R1] =
+                    ecdh_doit[R_EC_BRP384T1] =
+                    ecdh_doit[R_EC_BRP512R1] =
+                    ecdh_doit[R_EC_BRP512T1] = 0;
+            }
         }
         for (i = 0; i < EC_NUM; i++) {
             /* Negative values are ECDH-only curves */
@@ -2491,6 +2526,38 @@
         do_kems = 1;
         memset(sigs_doit, 1, sizeof(sigs_doit));
