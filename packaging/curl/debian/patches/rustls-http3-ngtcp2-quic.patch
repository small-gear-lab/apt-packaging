+#ifdef USE_HTTP3
+CURLcode Curl_rustls_quic_ctx_init(struct rustls_quic_ctx *ctx,
+                                   struct Curl_cfilter *cf,
+                                   struct Curl_easy *data,
+                                   struct ssl_peer *peer,
+                                   const struct alpn_spec *alpns)
+{
+  CURLcode result;
+  size_t i;
+
+  memset(ctx, 0, sizeof(*ctx));
+  result = cr_build_config(cf, data, alpns, peer->origin, &ctx->config);
+  if(result)
+    return result;
+
+  ctx->hostname = curlx_strdup(peer->origin->hostname);
+  if(!ctx->hostname) {
+    Curl_rustls_quic_ctx_free(ctx);
+    return CURLE_OUT_OF_MEMORY;
+  }
+  /* the ALPN list in wire format, as the ngtcp2 helper takes it */
+  for(i = 0; alpns && i < alpns->count; ++i) {
+    size_t len = strlen(alpns->entries[i]);
+    if(len > 255 || ctx->alpnlen + 1 + len > sizeof(ctx->alpn)) {
+      Curl_rustls_quic_ctx_free(ctx);
+      return CURLE_FAILED_INIT;
+    }
+    ctx->alpn[ctx->alpnlen++] = (unsigned char)len;
+    memcpy(ctx->alpn + ctx->alpnlen, alpns->entries[i], len);
+    ctx->alpnlen += len;
+  }
+  return CURLE_OK;
+}
+
+void Curl_rustls_quic_ctx_free(struct rustls_quic_ctx *ctx)
+{
+  if(ctx->config)
+    rustls_client_config_free(ctx->config);
+  curlx_free(ctx->hostname);
+  memset(ctx, 0, sizeof(*ctx));
+}
