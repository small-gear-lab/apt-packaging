diff --git a/configure.ac b/configure.ac
index 49886c5..76866d9 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3640,6 +3640,63 @@ if test "$USE_NGTCP2" = "1" && test "$WOLFSSL_ENABLED" = "1"; then
   fi
 fi
 
+if test "$USE_NGTCP2" = "1" && test "$RUSTLS_ENABLED" = "1"; then
+  dnl backup the pre-ngtcp2_crypto_rustls variables
+  CLEANLDFLAGS="$LDFLAGS"
+  CLEANLDFLAGSPC="$LDFLAGSPC"
+  CLEANCPPFLAGS="$CPPFLAGS"
+  CLEANLIBS="$LIBS"
+
+  CURL_CHECK_PKGCONFIG(libngtcp2_crypto_rustls, $want_tcp2_path, 1)
+
+  if test "$PKGCONFIG" != "no"; then
+    LIB_NGTCP2_CRYPTO_RUSTLS=`CURL_EXPORT_PCDIR([$want_tcp2_path], 1)
+      $PKGCONFIG --libs-only-l libngtcp2_crypto_rustls`
+    AC_MSG_NOTICE([-l is $LIB_NGTCP2_CRYPTO_RUSTLS])
+
+    CPP_NGTCP2_CRYPTO_RUSTLS=`CURL_EXPORT_PCDIR([$want_tcp2_path], 1)
+      $PKGCONFIG --cflags-only-I libngtcp2_crypto_rustls`
+    AC_MSG_NOTICE([-I is $CPP_NGTCP2_CRYPTO_RUSTLS])
+
+    LD_NGTCP2_CRYPTO_RUSTLS=`CURL_EXPORT_PCDIR([$want_tcp2_path], 1)
+      $PKGCONFIG --libs-only-L libngtcp2_crypto_rustls`
+    AC_MSG_NOTICE([-L is $LD_NGTCP2_CRYPTO_RUSTLS])
+
+    LDFLAGS="$LDFLAGS $LD_NGTCP2_CRYPTO_RUSTLS"
+    LDFLAGSPC="$LDFLAGSPC $LD_NGTCP2_CRYPTO_RUSTLS"
+    CPPFLAGS="$CPPFLAGS $CPP_NGTCP2_CRYPTO_RUSTLS"
+    LIBS="$LIB_NGTCP2_CRYPTO_RUSTLS $LIBS"
+
+    if test "$cross_compiling" != "yes"; then
+      DIR_NGTCP2_CRYPTO_RUSTLS=`echo $LD_NGTCP2_CRYPTO_RUSTLS | $SED -e 's/^-L//'`
+    fi
+    AC_CHECK_LIB(ngtcp2_crypto_rustls, ngtcp2_crypto_recv_client_initial_cb,
+      [
+        AC_CHECK_HEADERS(ngtcp2/ngtcp2_crypto.h,
+          USE_NGTCP2=1
+          CURL_LIBRARY_PATH="$CURL_LIBRARY_PATH:$DIR_NGTCP2_CRYPTO_RUSTLS"
+          export CURL_LIBRARY_PATH
+          AC_MSG_NOTICE([Added $DIR_NGTCP2_CRYPTO_RUSTLS to CURL_LIBRARY_PATH])
+          LIBCURL_PC_REQUIRES_PRIVATE="$LIBCURL_PC_REQUIRES_PRIVATE libngtcp2_crypto_rustls"
+        )
+      ],
+        dnl not found, revert back to clean variables
+        LDFLAGS=$CLEANLDFLAGS
+        LDFLAGSPC=$CLEANLDFLAGSPC
+        CPPFLAGS=$CLEANCPPFLAGS
+        LIBS=$CLEANLIBS
+    )
+
+  else
+    dnl no ngtcp2_crypto_rustls pkg-config found, deal with it
+    if test "$want_tcp2" != "default"; then
+      dnl To avoid link errors, we do not allow --with-ngtcp2 without
+      dnl a pkgconfig file
+      AC_MSG_ERROR([--with-ngtcp2 was specified but could not find ngtcp2_crypto_rustls pkg-config file.])
+    fi
+  fi
+fi
+
