# This library package is a flavour: the package that other packages depend on is the metapackage libcurl4t64,
# and the shlibs of libcurl.so.4 name it, so that switching the flavour does not touch them.
libcurl4t64-rustls: distant-prerequisite-in-shlibs * [shlibs]
libcurl4t64-rustls: package-name-doesnt-match-sonames libcurl4
