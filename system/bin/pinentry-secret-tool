#!/usr/bin/python3 -I
"""Pinentry for rbw: answer the master password from the Secret Service, ask for the rest.

Meant for `rbw config set pinentry <this file>`.

* A prompt that mentions "master" is answered with
  `secret-tool lookup service vaultwarden account <email>`; <email> comes from
  rbw's own config.
* Any other prompt (e.g. a two-factor code) never gets the master password. It is
  handed to pinentry-curses on the terminal rbw reports with `OPTION ttyname=`,
  or to pinentry-gnome3 when no terminal is known.

Set SECRET_TOOL_PINENTRY_FALLBACK to use a different program for the second case.
Nothing is logged.
"""
import json
import os
import subprocess
import sys

CURSES = '/usr/bin/pinentry-curses'
GUI = '/usr/bin/pinentry-gnome3'


def lookup_password():
    config_home = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    with open(os.path.join(config_home, 'rbw', 'config.json')) as f:
        email = json.load(f)['email']
    result = subprocess.run(
        ['secret-tool', 'lookup', 'service', 'vaultwarden', 'account', email],
        capture_output=True, text=True,
    )
    if result.returncode != 0 or not result.stdout:
        return None
    return result.stdout.rstrip('\n')


def assuan_escape(s):
    return s.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')


def read_reply(child):
    """Read lines from a child pinentry up to and including its OK/ERR line."""
    lines = []
    while True:
        line = child.stdout.readline()
        if not line:
            break
        lines.append(line)
        if line.startswith(('OK', 'ERR')):
            break
    return lines


def delegate(buffered, getpin_line):
    """Replay the buffered commands to a real pinentry and return its GETPIN reply."""
    has_tty = any(l.upper().startswith('OPTION TTYNAME=') for l in buffered)
    program = os.environ.get('SECRET_TOOL_PINENTRY_FALLBACK') or (CURSES if has_tty else GUI)
    child = subprocess.Popen([program], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    try:
        child.stdout.readline()  # greeting
        for line in buffered:
            child.stdin.write(line)
            child.stdin.flush()
            read_reply(child)
        child.stdin.write(getpin_line)
        child.stdin.flush()
        reply = read_reply(child)
        child.stdin.write('BYE\n')
        child.stdin.flush()
    finally:
        child.stdin.close()
        child.wait(timeout=10)
    return reply or ['ERR 83886179 Operation cancelled\n']


def main():
    out = sys.stdout
    out.write('OK Pleased to meet you\n')
    out.flush()
    buffered = []
    shown_text = ''
    for line in sys.stdin:
        parts = line.strip().split(' ', 1)
        command = parts[0].upper()
        if command == 'GETPIN':
            if 'master' in shown_text.lower():
                password = lookup_password()
                if password is None:
                    out.write('ERR 83886179 Operation cancelled\n')
                else:
                    out.write('D ' + assuan_escape(password) + '\nOK\n')
            else:
                out.writelines(delegate(buffered, line))
            buffered = []
            shown_text = ''
        elif command == 'GETINFO':
            what = parts[1] if len(parts) > 1 else ''
            value = {'pid': str(os.getpid()), 'version': '1.0', 'flavor': 'secret-tool'}.get(what)
            out.write(('D ' + value + '\n' if value else '') + 'OK\n')
        elif command == 'BYE':
            out.write('OK closing connection\n')
            out.flush()
            return
        else:
            if command in ('SETPROMPT', 'SETDESC', 'SETTITLE') and len(parts) > 1:
                shown_text += ' ' + parts[1]
            buffered.append(line)
            out.write('OK\n')
        out.flush()


if __name__ == '__main__':
    main()
